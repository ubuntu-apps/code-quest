  "highlight": {
    "tokens": [
      {
        "kind": "comment",
        "pattern": "#[^\\n]*"
      },
      {
        "kind": "string",
        "pattern": "(?:[rRbBuUfF]{1,2})?(?:\"\"\"[\\s\\S]*?(?:\"\"\"|$)|'''[\\s\\S]*?(?:'''|$)|\"(?:\\\\.|[^\"\\\\\\n])*\"?|'(?:\\\\.|[^'\\\\\\n])*'?)"
      },
      {
        "kind": "number",
        "pattern": "\\b0[xXoObB][0-9a-fA-F_]+\\b|\\b\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][+-]?\\d+)?j?\\b|\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
      },
      {
        "kind": "decorator",
        "pattern": "@[A-Za-z_][\\w.]*"
      },
      {
        "kind": "name",
        "pattern": "[A-Za-z_]\\w*"
      }
    ],
    "names": [
      {
        "kind": "keyword",
        "words": "keywords"
      },
      {
        "kind": "constant",
        "words": "constants"
      },
      {
        "kind": "name",
        "after": [
          "def",
          "class"
        ]
      },
      {
        "kind": "builtin",
        "words": "builtins"
      }
    ]
  },
  "tryIt": {
    "commentPrefix": "#",
    "codeLines": [
      "^\\s*(import|from|def|class|for|while|if|elif|else|try|except|finally|with|return|raise|assert|match|case|async|lambda|print)\\b",
      "^\\s*@\\w",
      "^\\s*[A-Za-z_][\\w.[\\]'\"]*(\\s*,\\s*[A-Za-z_][\\w.[\\]]*)*\\s*(\\*\\*|\\/\\/|[+\\-*/%])?=(?!=)",
      "^\\s*[A-Za-z_][\\w.]*\\("
    ],
    "notCodeLines": [
      "^(>|\\$|>>>) ",
      "^\\s*(python|pip|py|npm|cd|source)\\s",
      "^[A-Za-z][\\w%]*( [\\w%()]+)+: ",
      "^[A-Z][a-z]+: "
    ],
    "errorDemo": "#.*\\berror\\b"
  },
  "editor": {
    "indentSize": 4,
    "suggestKeywords": [
      "suggestKeywords"
    ],
    "suggestFunctions": [
      "suggestFunctions"
    ]
  },
  "keys": [
    {
      "special": "indent"
    },
    {
      "special": "unindent"
    },
    ":",
    {
      "pair": [
        "(",
        ")"
      ],
      "aria": "Parentheses"
    },
    {
      "pair": [
        "[",
        "]"
      ],
      "aria": "Square brackets"
    },
    {
      "pair": [
        "\"",
        "\""
      ],
      "aria": "Double quotes"
    },
    {
      "pair": [
        "'",
        "'"
      ],
      "aria": "Single quotes"
    },
    "=",
    {
      "text": "_",
      "aria": "Underscore"
    },
    {
      "text": ".",
      "aria": "Dot"
    },
    ",",
    "#",
    {
      "pair": [
        "{",
        "}"
      ],
      "aria": "Curly braces"
    },
    "+",
    "-",
    "*",
    "/",
    "<",
    ">",
    "!"
  ],
  "sandbox": {
    "defaultCode": "print(\"Hello from CodeQuest!\")",
    "samples": [
      {
        "id": "hello",
        "label": "Hello",
        "code": "print(\"Hello, Python!\")"
      },
      {
        "id": "variables",
        "label": "Variables",
        "code": "name = \"Alex\"\nscore = 7\nprint(name)\nprint(score)"
      },
      {
        "id": "loop",
        "label": "Loop",
        "code": "for i in range(3):\n    print(\"Step\", i)"
      },
      {
        "id": "function",
        "label": "Function",
        "code": "def add(a, b):\n    return a + b\n\nprint(add(2, 3))"
      }
    ],
    "input": {
      "detect": "\\binput\\s*\\(",
      "call": "input()"
    }
  },
  "messages": {
    "status": {
      "waiting": "Waiting for the previous run to finish…",
      "waiting-download": "Waiting for \"Download for offline\" to finish…",
      "loading": "Downloading Python (first run only, about 10 MB)…",
      "packages": "Downloading the packages this code uses, such as pandas (first time only)…",
      "running": "Running…"
    }
  },
  "offline": {
    "stepLabel": "Downloading Python and the packages the stages use…"
  }
}
