  "highlight": {
    "caseInsensitive": true,
    "tokens": [
      {
        "kind": "comment",
        "pattern": "--[^\\n]*|\\/\\*[\\s\\S]*?(?:\\*\\/|$)"
      },
      {
        "kind": "string",
        "pattern": "'(?:[^']|'')*'?"
      },
      {
        "kind": "number",
        "pattern": "\\b\\d+(?:\\.\\d*)?(?:[eE][+-]?\\d+)?\\b|\\.\\d+\\b"
      },
      {
        "kind": "name",
        "pattern": "[A-Za-z_][\\w$]*"
      }
    ],
    "names": [
      {
        "kind": "constant",
        "words": "literals"
      },
      {
        "kind": "keyword",
        "words": "keywords"
      },
      {
        "kind": "builtin",
        "words": "functions",
        "call": true
      }
    ]
  },
  "tryIt": {
    "commentPrefix": "--",
    "firstLine": {
      "pattern": "^\\s*(SELECT|WITH|INSERT|UPDATE|DELETE|REPLACE|CREATE|DROP|ALTER|BEGIN|PRAGMA|EXPLAIN)\\b",
      "flags": "i"
    }
  },
  "editor": {
    "indentSize": 4,
    "suggestKeywords": [
      "keywords"
    ],
    "suggestFunctions": [
      "functions"
    ]
  },
  "keys": [
    {
      "pair": [
        "(",
        ")"
      ],
      "aria": "Parentheses"
    },
    {
      "pair": [
        "'",
        "'"
      ],
      "aria": "Single quotes"
    },
    ",",
    {
      "text": ".",
      "aria": "Dot"
    },
    {
      "text": "_",
      "aria": "Underscore"
    },
    {
      "text": ";",
      "aria": "Semicolon"
    },
    "=",
    "*",
    {
      "text": "%",
      "aria": "Percent"
    },
    {
      "text": "||",
      "aria": "Join text (two bars)"
    },
    "<",
    ">",
    "-",
    "+",
    "/",
    "!",
    {
      "pair": [
        "\"",
        "\""
      ],
      "aria": "Double quotes"
    },
    {
      "special": "indent"
    },
    {
      "special": "unindent"
    }
  ],
  "sandbox": {
    "defaultCode": "SELECT 'Hello from CodeQuest!' AS greeting;",
    "samples": [
      {
        "id": "hello",
        "label": "Hello",
        "code": "SELECT 'Hello, SQL!' AS greeting;"
      },
      {
        "id": "maths",
        "label": "Maths",
        "code": "SELECT 2 + 3 AS total, 10 / 4.0 AS quarter;"
      }
    ]
  },
  "messages": {
    "status": {
      "waiting": "Waiting for the previous run to finish…",
      "waiting-download": "Waiting for \"Download for offline\" to finish…",
      "loading": "Getting the SQL engine ready (first run only, about 10 MB)…",
      "packages": "Downloading SQLite (first run only)…",
      "running": "Running…"
    }
  },
  "offline": {
    "stepLabel": "Downloading the SQL engine…"
  }
}
