  "highlight": {
    "tokens": [
      {
        "kind": "comment",
        "pattern": "#[^\\n]*"
      },
      {
        "kind": "string",
        "pattern": "\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"?|'(?:\\\\[\\s\\S]|[^'\\\\])*'?"
      },
      {
        "kind": "number",
        "pattern": "(?:\\b\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?L?"
      },
      {
        "kind": "plain",
        "pattern": "%[^%\\s]*%"
      },
      {
        "kind": "name",
        "pattern": "[A-Za-z.][\\w.]*"
      }
    ],
    "names": [
      {
        "kind": "keyword",
        "words": "keywords"
      },
      {
        "kind": "constant",
        "words": "constants"
      },
      {
        "kind": "builtin",
        "call": true
      }
    ]
  },
  "tryIt": {
    "commentPrefix": "#",
    "codeLines": [
      "<-|[A-Za-z_.][\\w.]*\\(|^\\s*-?[\\d.]+\\s*([-+*/^]|%%|%\\/%)\\s*[\\d.(]"
    ],
    "buildsOnEarlierBlocks": true,
    "errorDemo": "#.*\\berror\\b"
  },
  "editor": {
    "indentSize": 2,
    "suggestKeywords": [
      "keywords",
      "constants"
    ],
    "suggestFunctions": [
      "functions"
    ],
    "comments": {
      "line": "#"
    }
  },
  "keys": {
    "add": [
      {
        "text": "<-",
        "aria": "Assignment arrow"
      },
      {
        "text": "$",
        "aria": "Dollar"
      },
      ":",
      {
        "text": "~",
        "aria": "Tilde"
      },
      "%in%",
      "#",
      "&",
      "|"
    ],
    "remove": [
      "''"
    ]
  },
  "sandbox": {
    "defaultCode": "print(\"Hello from CodeQuest!\")",
    "samples": [
      {
        "id": "hello",
        "label": "Hello",
        "code": "print(\"Hello, R!\")"
      },
      {
        "id": "variables",
        "label": "Variables",
        "code": "name <- \"Alex\"\nscore <- 7\nprint(name)\nprint(score)"
      },
      {
        "id": "vector",
        "label": "Vector",
        "code": "nums <- c(1, 2, 3)\nprint(nums * 2)"
      },
      {
        "id": "function",
        "label": "Function",
        "code": "add <- function(a, b) a + b\nprint(add(2, 3))"
      }
    ]
  },
  "limits": {
    "runSeconds": 45
  },
  "messages": {
    "start": "Loading R runtime (first run downloads ~30MB, may take a minute)...",
    "runtimeLoadFailed": "Could not download the R runtime. Check your internet connection and try again.",
    "errors": {
      "tooLong": {
        "title": "Code took too long",
        "tip": "Look for a loop that never ends, such as `repeat` without a `break`, or a `while` condition that never becomes FALSE."
      },
      "stopped": {
        "tip": "If it seemed stuck, look for a loop whose condition never becomes FALSE."
      }
    }
  },
  "offline": {
    "stepLabel": "Downloading R…"
  },
  "course": {
    "unit": "stages",
    "shuffleChoices": true,
    "omitFromQuestions": [
      "check"
    ]
  }
}
